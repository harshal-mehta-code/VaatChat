{
  "name": "vaatchat",
  "version": "0.1.0",
  "private": true,
  "description": "A fun, research-backed, gamified Gujarati learning app \u2014 conversation-first for zero-exposure beginners.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "gen:audio": "node --experimental-strip-types scripts/generate-audio.ts",
    "check:audio": "node --experimental-strip-types scripts/check-audio.ts",
    "check:strokes": "node --experimental-strip-types scripts/check-strokes.ts",
    "check:translit": "node --experimental-strip-types scripts/check-translit.ts",
    "gen:review": "node --experimental-strip-types scripts/gen-review-sheet.ts",
    "check:sync": "node --experimental-strip-types scripts/check-sync.ts",
    "migrate": "node --env-file=.env.local --experimental-strip-types scripts/migrate.ts",
    "check:rls": "node --env-file=.env.local --experimental-strip-types scripts/check-rls.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.58.0",
    "next": "15.1.11",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "ts-fsrs": "4.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.10.7",
    "@types/pg": "8.11.10",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "pg": "8.13.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.3"
  }
}
